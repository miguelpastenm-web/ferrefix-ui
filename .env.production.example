# Producción (servidor). Esta plantilla NO lleva IPs reales y sí se versiona; el .env real está en .gitignore.
#
# Se copia a ".env" EN EL SERVIDOR, junto al docker-compose.yml:
#   cp .env.production.example .env
# y se reemplaza el placeholder <IP-DEL-BACKEND> por la IP pública del backend (SIN barra final).
#
# La URL se COMPILA dentro del bundle del front: si la IP cambia, no basta con editar el .env,
# hay que reconstruir la imagen:
#   docker compose up -d --build
#
# El backend debe tener CORS_ALLOWED_ORIGINS con el origen del front (p. ej. http://<IP-DEL-BACKEND>).
VITE_API_URL=http://<IP-DEL-BACKEND>:8080
